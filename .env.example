# -----------------------------------------------------------------------------
# T-Mobile & Zelle Automation - Environment Configuration
# -----------------------------------------------------------------------------
# 1. cp .env.example .env
# 2. Fill in the non-sensitive configuration below.
# 3. Sensitive credentials live in macOS Keychain - see README "Setup".
# -----------------------------------------------------------------------------

# --- SMTP CONFIG ---
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=xxxx_xxxx_xxxx_xxxx

# --- RECIPIENTS ---
# Bill summary email recipients (comma-separated)
RECIPIENT_EMAILS=example1@gmail.com,example2@gmail.com

# Optional: post-Zelle confirmation email goes to these instead of RECIPIENT_EMAILS
# CONFIRMATION_RECIPIENTS=you@gmail.com

# Optional: failure alerts go here. Defaults to first RECIPIENT_EMAILS entry.
# FAILURE_ALERT_EMAIL=you@gmail.com

# Optional: T-Mobile MFA push-approval prompt goes here. Defaults to FAILURE_ALERT_EMAIL.
# MFA_ALERT_EMAIL=you@gmail.com

# --- USER MAPPING (JSON string mapping phone numbers to names) ---
USER_MAPPING='{"1234567890": "John Doe", "0987654321": "Jane Smith"}'

# --- SPECIAL POOL CONFIG ---
SPECIAL_POOL_NAMES=Jane Smith
SPECIAL_POOL_TITLE=Premium Member Pool
SPECIAL_POOL_DESC=Covers additional roaming and insurance

# --- ZELLE LIVE SEND ---
# Default OFF. With this OFF, the BoA flow reaches the Review screen and stops
# without clicking Send. Set to 1 only after a successful dry-run cycle.
ZELLE_LIVE_SEND=0
